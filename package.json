{
  "name": "shop-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack engineering reference platform: Angular (Nx) + ASP.NET Core + PostgreSQL",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "start": "nx serve web",
    "start:signals": "nx serve web --configuration=development",
    "start:ngrx": "nx serve web --configuration=development-ngrx",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "e2e": "nx e2e web-e2e",
    "e2e:signals": "nx e2e web-e2e --configuration=signals",
    "e2e:ngrx": "nx e2e web-e2e --configuration=ngrx",
    "e2e:install-browsers": "playwright install chromium"
  },
  "dependencies": {
    "@angular/common": "~21.2.25",
    "@angular/compiler": "~21.2.25",
    "@angular/core": "~21.2.25",
    "@angular/forms": "~21.2.25",
    "@angular/platform-browser": "~21.2.25",
    "@angular/router": "~21.2.25",
    "@ngrx/effects": "~21.1.1",
    "@ngrx/entity": "~21.1.1",
    "@ngrx/operators": "~21.1.1",
    "@ngrx/store": "~21.1.1",
    "@ngrx/store-devtools": "~21.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.6.0",
    "@analogjs/vitest-angular": "~2.6.0",
    "@angular-devkit/core": "~21.2.27",
    "@angular-devkit/schematics": "~21.2.27",
    "@angular/build": "~21.2.27",
    "@angular/cli": "~21.2.27",
    "@angular/compiler-cli": "~21.2.25",
    "@angular/language-service": "~21.2.25",
    "@eslint/js": "^9.39.5",
    "@nx/angular": "23.3.0",
    "@nx/eslint": "^23.3.0",
    "@nx/eslint-plugin": "^23.3.0",
    "@nx/js": "23.3.0",
    "@nx/playwright": "^23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "~1.64.1",
    "@schematics/angular": "~21.2.27",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "angular-eslint": "~21.4.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.0.0",
    "nx": "23.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.0",
    "vitest": "~4.1.12"
  }
