{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Shop": ""
  },
  "Auth": {
    "Issuer": "shop-api",
    "Audience": "shop-web",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "RefreshCookieSecure": true
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDevelopmentData": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindow": "00:01:00",
    "CheckoutPermitLimit": 10,
    "CheckoutWindow": "00:01:00",
    "AssistantPermitLimit": 20,
    "AssistantWindow": "00:01:00"
  },
  "Assistant": {
    "Provider": "Mock",
    "OpenAiCompatible": {
      "BaseUrl": null,
      "Model": "",
      "Timeout": "00:00:20",
      "MaxOutputTokens": 400,
      "WarmUpOnStart": false
    }
  },
  "Notifications": {
    "BaseUrl": null,
    "ServiceKey": ""
  },
  "Outbox": {
    "PublisherEnabled": true,
    "PollInterval": "00:00:02",
    "BatchSize": 20,
    "MaxAttempts": 8,
    "ClaimDuration": "00:05:00"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
