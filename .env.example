# Copy to .env to override docker-compose defaults. .env is git-ignored.
# Development-only values; never put real secrets in this file or in the repository.
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_dev_password
POSTGRES_PORT=5433
WEB_PORT=8080
WEB_NGRX_PORT=8081
# At least 32 characters. Generate one with: openssl rand -base64 48
AUTH_SIGNING_KEY=DEV-ONLY-signing-key-do-not-use-in-production-0123456789
# Requests per minute; raise (e.g. 10000) only to run the E2E suite against the containers.
API_AUTH_PERMIT_LIMIT=10
API_CHECKOUT_PERMIT_LIMIT=10
API_ASSISTANT_PERMIT_LIMIT=20
# Assistant model: Mock (offline, default) or OpenAiCompatible (e.g. Ollama on the host:
#   ollama pull qwen2.5:7b). An API key for a hosted provider goes into .env only, never into the repository.
ASSISTANT_PROVIDER=Mock
ASSISTANT_BASE_URL=http://host.docker.internal:11434/v1
ASSISTANT_MODEL=qwen2.5:7b
ASSISTANT_TIMEOUT=00:01:30
# Shared key between the API (outbox publisher) and the notifications service; at least 16 characters.
NOTIFICATIONS_SERVICE_KEY=DEV-ONLY-notifications-service-key
NOTIFICATIONS_PORT=5090
